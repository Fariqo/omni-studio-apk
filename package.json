{
  "name": "omni-apex-studio-os",
  "version": "3.0.0",
  "description": "OMNI-APEX: AI Studio, RAG Engine & Multi-Platform App Factory",
  "author": "Omni-Apex Studio",
  "license": "MIT",
  "main": "electron-main.js",
  "scripts": {
    "build:web": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('index.html','dist/index.html');if(fs.existsSync('manifest.json'))fs.copyFileSync('manifest.json','dist/manifest.json');\"",
    "android:sync": "npm run build:web && npx cap sync android",
    "electron:win": "electron-builder --win nsis portable --publish never",
    "electron:mac": "electron-builder --mac dmg zip --publish never",
    "electron:linux": "electron-builder --linux AppImage --publish never"
  },
  "build": {
    "appId": "com.omniapex.studio",
    "productName": "OmniApexStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "omni-bridge.ps1",
      "baslat.bat",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false,
      "filesystem": "HFS+"
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
