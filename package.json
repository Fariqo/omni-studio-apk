{
  "name": "omni-apex-studio-os",
  "version": "6.0.0",
  "description": "OMNI-NEXUS APEX OS v6.0: 5 Uzman Arayuz, Gercek Gemini Function Calling Ajan, PC IDE, Otomasyon, Siber RBP & Coklu-Bulut",
  "author": "Omni-Apex Studio",
  "license": "MIT",
  "main": "electron-main.js",
  "scripts": {
    "build:web": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync('dist',{recursive:true});if(fs.existsSync('v6')){fs.cpSync('v6','dist',{recursive:true});}else if(fs.existsSync('index.html')){fs.copyFileSync('index.html','dist/index.html');}if(fs.existsSync('manifest.json'))fs.copyFileSync('manifest.json','dist/manifest.json');\"",
    "android:sync": "npm run build:web && npx cap sync android",
    "electron:win": "electron-builder --win nsis portable msi --publish never",
    "electron:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "electron:linux": "electron-builder --linux AppImage --publish never"
  },
  "build": {
    "appId": "com.omniapex.studio",
    "productName": "OmniApexStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js"
    ],
    "extraResources": [
      "baslat.bat",
      "omni-bridge.ps1"
    ],
    "win": {
      "target": ["nsis", "portable", "msi"]
    },
    "msi": {
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
